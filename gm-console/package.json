{
  "name": "@gameserver/gm-console-workspace",
  "version": "0.7.0",
  "private": true,
  "description": "GM console of the game server framework: the shell package, the default app, the static-host reference and the end-to-end smoke.",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "gen:api": "node scripts/gen-api.mjs",
    "check:api": "node scripts/gen-api.mjs --check",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -p packages/shell/tsconfig.json && tsc -p packages/shell/tsconfig.test.json && tsc -p app/tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "build": "npm run build -w app",
    "check:dist": "node scripts/check-dist.mjs app/dist",
    "verify": "npm run check:api && npm run lint && npm run typecheck && npm run test && npm run build && npm run check:dist",
    "dev": "npm run dev -w app",
    "preview": "npm run preview -w app",
    "e2e": "vitest run --config e2e/vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "vitest": "5.0.5"
  }
}
