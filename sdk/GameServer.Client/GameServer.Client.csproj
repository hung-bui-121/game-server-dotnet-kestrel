<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds the Unity client SDK outside Unity (tests, bots, load tools). The sources live in the UPM package so Unity and
    .NET compile the same files; C# 9 and netstandard2.1 match Unity 2021.3+ (research R1).
    Runtime/Generated (protoc output, FrameworkRoutes, FrameworkSections) is committed and produced by the WireGen
    "generate" verb with wiregen.json next to this file (FG-021, BC-6); the build never writes into the package.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>GameServer.Client</RootNamespace>
    <PackageRoot>..\unity\com.gameserver.client\</PackageRoot>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(PackageRoot)Runtime\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>
  <ItemGroup>
    <None Include="wiregen.json" />
  </ItemGroup>
</Project>
