<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>GameServer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only DI abstractions here; no ASP.NET Core, Couchbase or Protobuf (ARC-01). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- ConfigContext/ConfigProblems are created by the declaration engine only (FG-018, research R5). -->
