/tests/ConsumerFixture/.local/

# GM console (slice 018): dependencies, build output and e2e artifacts are never committed (FR-042)
gm-console/**/node_modules/
gm-console/**/dist/
gm-console/e2e/.artifacts/
gm-console/**/*.tsbuildinfo
