<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Local load / concurrency driver (ACC-06, ACC-16, ACC-52) built on the .NET build of the Unity SDK, so traffic uses the
    same Protobuf contract, headers and requestId handling as a real client. Not part of the deployable server.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../sdk/GameServer.Client/GameServer.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- SampleGame contract, generated by sdk/GameServer.Client into the KestrelDemo client (lockstep with the server). -->
    <Compile Include="../../samples/SampleGame/KestrelDemo/Assets/SampleGame/Generated/SampleGame.cs" Link="Generated/SampleGame.cs" />
  </ItemGroup>
</Project>
