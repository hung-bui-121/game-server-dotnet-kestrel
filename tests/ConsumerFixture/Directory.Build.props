<Project>
  <!--
    Consumer-shaped build settings (research R17): this folder plays a game repository with the framework as a sibling
    checkout. MSBuild stops at the first Directory.Build.props found upward, so the framework's root props (and its
    path-based IsTestProject rule) never apply to these projects, exactly as in a game repository; framework projects
    referenced through $(GameServerRoot) keep the framework's own props.
  -->
  <PropertyGroup>
    <GameServerRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</GameServerRoot>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- By name, not by path: a game repository may itself sit under a folder named "tests". -->
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Game code: the framework's analyzers and banned APIs (PERF-01, TIME-01). -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(GameServerRoot)BannedSymbols.txt" />
  </ItemGroup>
</Project>
